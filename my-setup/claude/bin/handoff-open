#!/usr/bin/env bash
# Runs inside the Harp or Warp tab that `handoff` opened for one job: claims that job and starts it.
# Usage: handoff-open <job file name>
set -uo pipefail

QUEUE="$HOME/.claude/handoff/pending"
job="$QUEUE/${1:-none}.claimed"
# mv is atomic, so a job starts at most once even if its tab opens twice.
if ! mv "$QUEUE/${1:-none}" "$job" 2>/dev/null; then
  echo "handoff: no queued task ${1:-}"
  exit 0
fi

name=$(jq -r .name "$job")
cwd=$(jq -r .cwd "$job")
session_id=$(jq -r '.session_id // empty' "$job")
prompt=$(jq -r .prompt "$job")
rm -f "$job" "$HOME/.harp/tab_configs/handoff-$name.toml" "$HOME/.warp/tab_configs/handoff-$name.toml"

cd "$cwd" 2>/dev/null || echo "handoff: $cwd is missing, staying in $PWD"
printf '\033]0;%s\007' "⎿ $name"
# Keep the "⎿ name" title: Claude Code would otherwise retitle the tab with its own topic.
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
claude ${session_id:+--session-id "$session_id"} -n "$name" "$prompt"
