#!/usr/bin/env bash
# Queue a task for a new Claude session and open it in a new Harp (or Warp) tab.
# Usage: handoff --name <kebab-name> --parent <session-name> [--mode standalone|report|interactive] [--cwd DIR] < prompt
set -euo pipefail

QUEUE="$HOME/.claude/handoff/pending"
COLORS=(blue magenta cyan green yellow red)

name="" parent="" mode="report" cwd="$PWD"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) name="$2"; shift 2 ;;
    --parent) parent="$2"; shift 2 ;;
    --mode) mode="$2"; shift 2 ;;
    --cwd) cwd="$2"; shift 2 ;;
    *) echo "handoff: unknown arg $1" >&2; exit 2 ;;
  esac
done
[[ -n $name && -n $parent ]] || { echo "handoff: --name and --parent are required" >&2; exit 2; }
[[ $name =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]] || { echo "handoff: name must be kebab-case, at most 24 characters" >&2; exit 2; }
prompt=$(cat)
[[ -n $prompt ]] || { echo "handoff: empty prompt on stdin" >&2; exit 2; }

case "$mode" in
  standalone) rules="Work on this on your own. Do not message the session that started you. Finish the task and stop." ;;
  report) rules="You were started by the Claude session \"$parent\". Use SendMessage to \"$parent\" only for a blocker, a decision you cannot make yourself, or a short final result. Send nothing else." ;;
  interactive) rules="A human will talk to you directly in this tab, so ask them, not the parent. When the task is done, send one short final result to the Claude session \"$parent\" with SendMessage." ;;
  *) echo "handoff: mode must be standalone, report or interactive" >&2; exit 2 ;;
esac

# Children of one parent share a tab color, so a family reads as a group.
hash=$(printf '%s' "$parent" | cksum | cut -d' ' -f1)
color=${COLORS[$((hash % ${#COLORS[@]}))]}

# The child's session id is picked here so Harp can show who started whom: under
# ~/.claude/handoff, parents/<session id> marks a parent and children/<session id> holds the
# parent's name, session id and folder (Harp opens the child next to the parent's tab and leaves
# the folder off the child's row when it matches).
session_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
FAMILY="$HOME/.claude/handoff"
mkdir -p "$QUEUE" "$FAMILY/parents" "$FAMILY/children"
[[ -n ${CLAUDE_CODE_SESSION_ID:-} ]] && touch "$FAMILY/parents/$CLAUDE_CODE_SESSION_ID"
printf '%s\n%s\n%s\n' "$parent" "${CLAUDE_CODE_SESSION_ID:-}" "$PWD" > "$FAMILY/children/$session_id"

job="$QUEUE/$(date +%s)-$$-$name.json"
jq -n --arg name "$name" --arg parent "$parent" --arg mode "$mode" --arg cwd "$cwd" --arg session_id "$session_id" \
  --arg prompt "$prompt"$'\n\n'"$rules" '{name:$name,parent:$parent,mode:$mode,cwd:$cwd,session_id:$session_id,prompt:$prompt}' > "$job.tmp"
mv "$job.tmp" "$job"

# A one-off tab config (handoff-open deletes it) starts the tab's shell in the task folder, so
# the sidebar shows that path. $1 is harp or warp.
open_tab() {
  local config="$HOME/.$1/tab_configs/handoff-$name.toml"
  mkdir -p "${config%/*}"
  cat > "$config" <<EOF
name = "Handoff $name"
color = "$color"

[[panes]]
id = "main"
type = "terminal"
directory = "$cwd"
commands = ["$HOME/.claude/bin/handoff-open"]
EOF
  open "$1://tab_config/handoff-$name"
}

# A session inside Harp or Warp knows from its own environment; pgrep covers other terminals
# (it sees no processes from inside a sandboxed Claude shell).
app=""
case "${__CFBundleIdentifier:-}" in
  com.dominikmartn.Harp) app=harp ;;
  dev.warp.*) app=warp ;;
esac
[[ -z $app ]] && pgrep -qf 'Harp.app/Contents/MacOS' && app=harp
[[ -z $app ]] && pgrep -qf 'Warp.app/Contents/MacOS' && app=warp

if [[ $app == harp ]]; then
  open_tab harp
  echo "handoff: opening \"$name\" in a new Harp tab ($color)"
elif [[ $app == warp ]]; then
  open_tab warp
  echo "handoff: opening \"$name\" in a new Warp tab ($color)"
else
  # No Harp or Warp window to open a tab in: start it in the background so the work begins anyway.
  rm "$job"
  (cd "$cwd" && claude --bg --session-id "$session_id" -n "$name" "$prompt"$'\n\n'"$rules")
  echo "handoff: neither Harp nor Warp is running, started \"$name\" in the background (claude attach $name)"
fi
